# Required in production: use the public HTTPS origin with no trailing slash.
PUBLIC_BASE_URL=https://your-healthtwin-domain.example
# Use a long, unique secret in production. Never commit the actual value.
SECRET_KEY=replace-with-a-long-random-secret
# Optional consent-gated Plausible analytics. Leave blank to disable analytics.
PLAUSIBLE_DOMAIN=your-healthtwin-domain.example
PLAUSIBLE_SCRIPT_URL=https://plausible.io/js/script.js
